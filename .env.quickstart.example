# Optional overrides for `docker compose up`.
# Copy this file to .env.quickstart, edit it, then pass
# `--env-file .env.quickstart` to Docker Compose.

MULTIFORUM_INSTANCE_NAME=My Multiforum
MULTIFORUM_BOOTSTRAP_EMAIL=admin@multiforum.local
MULTIFORUM_BOOTSTRAP_USERNAME=admin
MULTIFORUM_BOOTSTRAP_PASSWORD=multiforum-local-admin
NEO4J_PASSWORD=multiforum-local-neo4j

# Keep the local development auth mode on loopback. Exposing it publicly is
# unsupported; use Auth0 or another production-ready identity provider instead.
MULTIFORUM_BIND_ADDRESS=127.0.0.1
MULTIFORUM_PUBLIC_FRONTEND_URL=http://localhost:3000

# The quick-start pulls the official backend and frontend images. Pin full
# release or immutable sha-* tags instead of edge for a repeatable installation.
MULTIFORUM_BACKEND_IMAGE=ghcr.io/gennit-project/multiforum-backend:edge
MULTIFORUM_BACKEND_PULL_POLICY=always
MULTIFORUM_FRONTEND_IMAGE=ghcr.io/gennit-project/multiforum-nuxt:edge
MULTIFORUM_FRONTEND_PULL_POLICY=always

# These settings are used only with docker-compose.source.yml when contributors
# deliberately build the application services from source.
MULTIFORUM_BACKEND_REPOSITORY=https://github.com/gennit-project/multiforum-backend.git
MULTIFORUM_BACKEND_REF=main
MULTIFORUM_SOURCE_BACKEND_IMAGE=multiforum-backend:quickstart
MULTIFORUM_SOURCE_FRONTEND_IMAGE=multiforum-frontend:quickstart

# Optional instance branding. Administrators can set the same values under
# Admin Settings -> Settings -> Branding; these variables set the deployment
# default, and NUXT_PUBLIC_BRANDING_LOCKED=true makes them authoritative and
# the admin form read-only.
#
# Leave these commented out to keep the built-in defaults. An assigned but
# EMPTY value is not the same as unset: it means "hide this link".
# NUXT_PUBLIC_BRANDING_LOGO_URL=
# NUXT_PUBLIC_BRANDING_LOGO_DARK_URL=
# NUXT_PUBLIC_BRANDING_LOGO_ALT=
# NUXT_PUBLIC_BRANDING_FAVICON_URL=
# NUXT_PUBLIC_BRANDING_PRIMARY_COLOR=
# NUXT_PUBLIC_BRANDING_PRODUCT_NAME=
# NUXT_PUBLIC_BRANDING_DOCS_URL=
# NUXT_PUBLIC_BRANDING_SOURCE_URL=
# NUXT_PUBLIC_BRANDING_ISSUES_URL=
# NUXT_PUBLIC_BRANDING_SUPPORT_EMAIL=
# NUXT_PUBLIC_BRANDING_SHOW_UPSTREAM_LINKS=true
# NUXT_PUBLIC_BRANDING_CUSTOM_FOOTER_LINKS=[{"label":"Handbook","url":"/handbook"}]
# NUXT_PUBLIC_BRANDING_LOCKED=false
