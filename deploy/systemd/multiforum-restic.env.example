# Use a repository supported by Restic. Keep this file mode 0600 when it
# contains object-storage credentials.
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=/etc/multiforum/restic-password

# Add provider-specific credentials below when the host does not use an
# instance role or another credential source supported by the provider.

MULTIFORUM_BACKUP_RESTIC_TAG=multiforum-production
MULTIFORUM_BACKUP_RESTIC_KEEP_DAILY=30
