#!/usr/bin/env bash

set -euo pipefail

printf '%s\n' "$*" >>"$MULTIFORUM_FAKE_DOCKER_LOG"

if [[ "${1:-}" == "compose" ]]; then
  case " $* " in
    *" config --format json "*)
      env_file=""
      previous_argument=""
      for argument in "$@"; do
        if [[ "$previous_argument" == "--env-file" ]]; then
          env_file="$argument"
          break
        fi
        previous_argument="$argument"
      done
      release_from_env=""
      if [[ -n "$env_file" && -f "$env_file" ]]; then
        release_from_env="$(awk -F= '$1 == "MULTIFORUM_RELEASE_VERSION" {sub(/^[^=]*=/, ""); value = $0} END {print value}' "$env_file")"
      fi
      if [[ -n "$release_from_env" ]]; then
        database_image="$(awk -F= '$1 == "MULTIFORUM_NEO4J_IMAGE" {sub(/^[^=]*=/, ""); value = $0} END {print value}' "$env_file")"
        backend_image="$(awk -F= '$1 == "MULTIFORUM_BACKEND_IMAGE" {sub(/^[^=]*=/, ""); value = $0} END {print value}' "$env_file")"
        frontend_image="$(awk -F= '$1 == "MULTIFORUM_FRONTEND_IMAGE" {sub(/^[^=]*=/, ""); value = $0} END {print value}' "$env_file")"
        caddy_image="$(awk -F= '$1 == "MULTIFORUM_CADDY_IMAGE" {sub(/^[^=]*=/, ""); value = $0} END {print value}' "$env_file")"
        release_version="$release_from_env"
      elif [[ "$*" == *"target.env"* ]]; then
        database_image="${MULTIFORUM_FAKE_TARGET_DATABASE_IMAGE:-neo4j:test}"
        backend_image="${MULTIFORUM_FAKE_TARGET_BACKEND_IMAGE:-ghcr.io/example/backend:1.2.3}"
        frontend_image="${MULTIFORUM_FAKE_TARGET_FRONTEND_IMAGE:-ghcr.io/example/frontend:1.2.3}"
        caddy_image="${MULTIFORUM_FAKE_TARGET_CADDY_IMAGE:-caddy:2.11.4-alpine}"
        release_version="${MULTIFORUM_FAKE_RELEASE_VERSION:-1.2.3}"
      else
        database_image="neo4j:test"
        backend_image="ghcr.io/example/backend:test"
        frontend_image="ghcr.io/example/frontend:test"
        caddy_image="caddy:test"
        release_version="${MULTIFORUM_FAKE_RELEASE_VERSION:-1.2.3}"
      fi
      jq --null-input \
        --arg databaseImage "$database_image" \
        --arg backendImage "$backend_image" \
        --arg frontendImage "$frontend_image" \
        --arg caddyImage "$caddy_image" \
        --arg releaseVersion "${MULTIFORUM_FAKE_RELEASE_VERSION:-$release_version}" \
        '
{
  "services": {
    "database": {"image": $databaseImage, "labels": {"net.multiforum.release": $releaseVersion}},
    "backend": {"image": $backendImage, "labels": {"net.multiforum.release": $releaseVersion}},
    "frontend": {"image": $frontendImage, "labels": {"net.multiforum.release": $releaseVersion}},
    "caddy": {
      "image": $caddyImage,
      "labels": {"net.multiforum.release": $releaseVersion},
      "environment": {"MULTIFORUM_DOMAIN": "forum.example.com"}
    }
  },
  "volumes": {
    "neo4j-data": {"name": "neo4j-volume"},
    "frontend-data": {"name": "frontend-volume"}
  }
}
'
      ;;
    *" ps --status running --services "*)
      if [[ -n "${MULTIFORUM_FAKE_RUNNING_SERVICES:-}" ]]; then
        printf '%s\n' "$MULTIFORUM_FAKE_RUNNING_SERVICES"
      else
        printf 'database\nbackend\nfrontend\n'
      fi
      ;;
    *" ps --services "*)
      if [[ -n "${MULTIFORUM_FAKE_RUNNING_SERVICES:-}" ]]; then
        printf '%s\n' "$MULTIFORUM_FAKE_RUNNING_SERVICES"
      else
        printf 'database\nbackend\nfrontend\n'
      fi
      ;;
    *" ps -q "*)
      service="${!#}"
      if [[ "${MULTIFORUM_FAKE_MISSING_SERVICE:-}" != "$service" ]]; then
        printf '%s-container\n' "$service"
      fi
      ;;
    *" stop frontend backend "*)
      if [[ "${MULTIFORUM_FAKE_FAIL_STOP:-false}" == true ]]; then
        exit 43
      fi
      ;;
    *" stop database "*)
      ;;
    *" up -d database backend frontend "*)
      if [[ "${MULTIFORUM_FAKE_FAIL_RESTART:-false}" == true ]]; then
        exit 44
      fi
      ;;
    *" pull database backend frontend caddy "*)
      if [[ "${MULTIFORUM_FAKE_FAIL_PULL:-false}" == true ]]; then
        exit 46
      fi
      ;;
    *" up -d --force-recreate --wait "*)
      if [[ "${MULTIFORUM_BACKEND_PULL_POLICY:-}" != never ||
        "${MULTIFORUM_FRONTEND_PULL_POLICY:-}" != never ]]; then
        echo "Upgrade recreation must use only the pre-pulled application images." >&2
        exit 48
      fi
      if [[ "${MULTIFORUM_FAKE_FAIL_UPGRADE:-false}" == true ]]; then
        exit 47
      fi
      ;;
    *" up -d --wait --wait-timeout 300 database backend frontend "*)
      if [[ "${MULTIFORUM_BOOTSTRAP_USERNAME:-}" != release_smoke_admin ]]; then
        echo "Release smoke must use a backend-compatible bootstrap username." >&2
        exit 51
      fi
      if [[ "${MULTIFORUM_FAKE_FAIL_RELEASE_SMOKE_START:-false}" == true ]]; then
        exit 49
      fi
      ;;
    *" down --volumes --remove-orphans "*)
      ;;
    *" logs --no-color --tail=200 database backend frontend "*)
      printf 'release smoke fixture logs\n'
      ;;
    *" ps "*)
      printf 'database running\nbackend running\nfrontend running\n'
      ;;
    *)
      echo "Unexpected fake Docker Compose command: $*" >&2
      exit 90
      ;;
  esac
elif [[ "${1:-}" == "inspect" ]]; then
  container_id="${!#}"
  service="${container_id%-container}"
  case "$service" in
    database) image="neo4j:test" ;;
    backend) image="ghcr.io/example/backend:test" ;;
    frontend) image="ghcr.io/example/frontend:test" ;;
    caddy) image="caddy:test" ;;
    *)
      echo "Unexpected fake container: $container_id" >&2
      exit 92
      ;;
  esac
  if [[ "${MULTIFORUM_FAKE_IMAGE_MISMATCH_SERVICE:-}" == "$service" ]]; then
    image="$image-mismatch"
  fi
  status=running
  health=healthy
  if [[ "$service" == caddy ]]; then
    health=none
  fi
  if [[ "${MULTIFORUM_FAKE_UNHEALTHY_SERVICE:-}" == "$service" ]]; then
    health=unhealthy
  fi
  release_version="${MULTIFORUM_FAKE_RUNNING_RELEASE_VERSION:-1.2.3}"
  printf '%s|%s|%s|%s\n' "$image" "$status" "$health" "$release_version"
elif [[ "${1:-}" == "run" ]]; then
  if [[ "$*" == *"caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile"* ]]; then
    if [[ "${MULTIFORUM_FAKE_FAIL_CADDY_VALIDATION:-false}" == true ]]; then
      exit 50
    fi
    exit 0
  fi
  if [[ "$*" == *":/target"* ]]; then
    cat >/dev/null
    if [[ "${MULTIFORUM_FAKE_FAIL_RESTORE_FRONTEND:-false}" == true && "$*" == *"frontend-volume:/target"* ]]; then
      exit 45
    fi
    exit 0
  fi
  if [[ "${MULTIFORUM_FAKE_FAIL_FRONTEND:-false}" == true && "$*" == *"frontend-volume:/source:ro"* ]]; then
    exit 42
  fi
  printf 'archive:%s\n' "$*"
else
  echo "Unexpected fake Docker command: $*" >&2
  exit 91
fi
